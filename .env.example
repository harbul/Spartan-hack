# StillHere environment variables. Copy to `.env` (gitignored) and fill in.
# Never commit real keys. The backend reads these locally; in Lambda they come
# from infra/template.yaml. The frontend reads only VITE_* (vite.config.ts uses this folder).
# Owner: P2 (Backend and infra). Plan: PLAN.md §4, §6, §7, §8.

# --- AWS ---------------------------------------------------------------------
# Region for Bedrock, Location, DynamoDB, S3 (local runs only; Lambda sets it itself).
# AWS credentials are NOT set here: use `aws configure` or your shell env.
AWS_REGION=us-west-2

# --- Amazon Bedrock (§4) -------------------------------------------------------
# Fast model for Jobs 1, 3, 4 (cross-region inference profile ID, e.g. us.anthropic.<model>;
# list them: aws bedrock list-inference-profiles --query "inferenceProfileSummaries[].inferenceProfileId")
BEDROCK_FAST_MODEL_ID=
# Strong model for Job 2 (multimodal) and Job 5 (agent)
BEDROCK_STRONG_MODEL_ID=
# Fallback model if access to the above is slow or denied (§16)
BEDROCK_FALLBACK_MODEL_ID=
# Guardrail for resident-facing messages and trace PII masking (§4 Job 6)
BEDROCK_GUARDRAIL_ID=
# Guardrail version number, or DRAFT
BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- Amazon Location Service (§6) ---------------------------------------------
# Optional backend API key for Routes calls; leave empty to use IAM credentials
LOCATION_API_KEY=

# --- DynamoDB tables (§7) and S3 bucket -----------------------------------------
# Residents registry
RESIDENTS_TABLE=stillhere-residents
# Outage zones
OUTAGES_TABLE=stillhere-outages
# One case per resident per outage
CASES_TABLE=stillhere-cases
# SMS, contact and door messages
MESSAGES_TABLE=stillhere-messages
# Dispatch plans
PLANS_TABLE=stillhere-plans
# One row per Bedrock call (AI Trace drawer)
TRACES_TABLE=stillhere-traces
# Timeline event log
EVENTS_TABLE=stillhere-events
# Clock offset, volunteers, resources
CONFIG_TABLE=stillhere-config
# Reply photos
PHOTOS_BUCKET=stillhere-photos

# --- Frontend (Vite exposes only VITE_* to the browser) ------------------------
# API base URL (SAM output ApiUrl, or http://localhost:8000 locally)
VITE_API_URL=http://localhost:8000
# true = screens run on frontend/src/api/mock.ts, no API needed (offline work until the AWS gate)
VITE_USE_MOCK=false
# Amazon Location API key for the browser map (Maps only). SAM creates it:
# aws location describe-key --key-name stillhere-maps --query Key --output text
VITE_LOCATION_API_KEY=
# Region of the Amazon Location API key (for the map style URL)
VITE_LOCATION_REGION=us-west-2
# Mapbox token, only if Amazon Location 3D terrain is unavailable (§6 fallback)
VITE_MAPBOX_TOKEN=
